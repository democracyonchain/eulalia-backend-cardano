NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CARDANO_NETWORK=Preview
BLOCKFROST_URL=https://cardano-preview.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=replace-with-preview-project-id
# Copy the address field from the existing funded wallet JSON file.
CNE_ADDRESS=replace-with-existing-funded-preview-address
# Keep the existing privateKey field from that same wallet JSON file.
CNE_PRIVATE_KEY=replace-with-preview-payment-private-key
INTERNAL_API_TOKEN=replace-with-a-long-random-token
METADATA_LABEL=1967
METADATA_SCHEMA_VERSION=1.0.0
DATA_FILE=./data/transactions.json
